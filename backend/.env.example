# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

# Primary Identity (Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Sandbox Hardware Boundaries (from readme.md: 2vCPU + 4GB-RAM)
SANDBOX_CPU_LIMIT=2.0
SANDBOX_MEMORY_LIMIT=4g
SANDBOX_STORAGE_LIMIT=10g

# Sandbox Provider ('e2b' | 'docker')
SANDBOX_PROVIDER=e2b
E2B_API_KEY=your_e2b_api_key_here

# Maximum concurrent sandboxes per user (LRU auto-eviction on limit)
MAX_SANDBOXES_PER_USER=3
