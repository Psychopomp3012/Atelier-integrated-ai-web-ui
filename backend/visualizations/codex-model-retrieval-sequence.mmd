sequenceDiagram
    autonumber
    actor User as User (Browser)
    participant FE as Frontend (models.service.ts)
    participant GW as Fastify Gateway (agent.controller.ts)
    participant FS as Google Cloud Firestore (cliLinks)
    participant AS as AgentService (agent.service.ts)
    participant SS as SandboxService (e2b-sandbox.provider.ts)
    participant VM as Cloud MicroVM (E2B Sandbox)
    participant OAI as OpenAI Auth & Model Endpoints

    %% -----------------------------------------------------------
    %% 1. FRONTEND INITIATION & LOCAL CACHE
    %% -----------------------------------------------------------
    rect rgb(24, 24, 37)
        Note over User,FE: 1. Frontend Trigger & In-Memory Deduplication
        User->>FE: Mounts UI / Opens Model Dropdown / Force Refresh
        FE->>FE: Check client cache (MODELS_CACHE_TTL = 30s) & deduplicate burst (<1.5s)
        alt Cache Valid & Not Forced
            FE-->>User: Return cached model list (instant UI render)
        else Cache Miss or force=true
            FE->>GW: GET /api/v1/agent/models<br/>[Header: Authorization: Bearer <JWT>]
        end
    end

    %% -----------------------------------------------------------
    %% 2. GATEWAY 4-PHASE DEFENSE PIPELINE & RESOLUTION
    %% -----------------------------------------------------------
    rect rgb(35, 30, 50)
        Note over GW,AS: 2. Gateway 4-Phase Defense Pipeline & Session Resolution
        GW->>GW: Phase 1: preValidation [requireAuth] strictly validates JWT HMAC token (Rejects 401 if missing/invalid)
        GW->>GW: Phase 2: preValidation [readApiLimitHook] (Tier 5: 120 req/min multi-tenant O(1) rate limit)
        GW->>GW: Phase 3: Fastify JSON Schema Validation (querystring additionalProperties: false, rejects 400)
        GW->>FS: Phase 4: IDOR ownership check on sessionId (firestoreBackendService.getSession)
        alt Session not owned by userId
            GW-->>FE: HTTP 403 Forbidden { error: "Access denied: You do not own this session" }
        else Session valid & owned
            GW->>AS: getAvailableModels(userId, sessionId, force)
            AS->>AS: resolveSandboxId(userId, sessionId)
            alt No Sandbox Active
                AS-->>GW: Return [] (no active VM to query)
                GW-->>FE: HTTP 200 { success: true, data: [] }
            else Sandbox ID Resolved (e.g. "ikky1x7f...")
                Note over AS: Proceed to cache lookup / discovery pipeline
            end
        end
    end

    %% -----------------------------------------------------------
    %% 3. BACKEND CACHE & IN-FLIGHT LOCK
    %% -----------------------------------------------------------
    rect rgb(20, 32, 45)
        Note over AS: 3. Backend Caching & Discovery Lock
        AS->>AS: Check sandboxModelsCache.get(sandboxId) (TTL: 300s)
        alt Cache Hit & !force
            AS-->>GW: Return cached models
            GW-->>FE: HTTP 200 { success: true, data: cachedModels }
        else Cache Miss or force=true
            AS->>AS: Deduplicate inFlightModelDiscovery.get(sandboxId)
            AS->>AS: fetchDynamicModelsFromCli(sandboxId, userId, sessionId)
        end
    end

    %% -----------------------------------------------------------
    %% 4. CODEX DISCOVERY & MULTI-TENANT LINKAGE GUARD
    %% -----------------------------------------------------------
    rect rgb(38, 28, 48)
        Note over AS,FS: 4. discoverCodexModels & JIT Credential Refresh
        AS->>AS: Execute discoverCodexModels(sandboxId, userId, sessionId)
        critical Multi-Tenant Linkage Guard Check
            Note over AS: Strict Authenticated Check: if (userId)
            AS->>FS: cliAuthService.getCliStatus(userId) -> Check Firestore cliLinks
            FS-->>AS: Return { codex: { linked: boolean, email: string } }
            alt codex.linked === false (Not Linked)
                Note over AS: Abort Codex discovery immediately
                AS-->>AS: Return [] (Skip VM execution to prevent leakage/waste)
            else codex.linked === true (Linked)
                AS->>AS: JIT Refresh: persistUserCodexProfile(userId, email)
                Note over AS: Evaluates findValidCodexAuthForEmail, checks token freshness & stages ~/.agent-user-profiles/{userId}/.codex/auth.json
                AS->>SS: syncCredentialsToSpecificSandbox(sandboxId, userId, force=true)
                Note over SS: Bypasses lastSyncedCredentialsHash (force=true) on discovery/reconnect
                SS->>VM: Write verified /home/agent-runner/.codex/auth.json (chmod 600, agent-runner DAC)
            end
        end
    end

    %% -----------------------------------------------------------
    %% 5. MICROVM SHELL EXECUTION (codex debug models)
    %% -----------------------------------------------------------
    rect rgb(25, 40, 35)
        Note over AS,OAI: 5. Live CLI Discovery in MicroVM Sandbox
        AS->>SS: executeInSandbox({ command: "sudo -u agent-runner -H env HOME=/home/agent-runner CODEX_HOME=/home/agent-runner/.codex bash -c 'test -s /home/agent-runner/.codex/auth.json && codex debug models'" })
        SS->>VM: Dispatches command over E2B encrypted control channel
        VM->>VM: Shell test: verifies /home/agent-runner/.codex/auth.json exists & non-empty
        alt auth.json missing or size == 0
            VM-->>SS: Exits with code 1 (no output)
            SS-->>AS: stdout = ''
        else auth.json valid & fresh
            VM->>OAI: codex debug models connects to OpenAI API with active token
            OAI-->>VM: Returns live model catalog JSON (~177 KB account models)
            VM-->>SS: stdout = '{"models": [{"slug": "gpt-6-luna", ...}, {"slug": "gpt-5.6-terra", ...}]}'
            SS-->>AS: cmdRes.stdout (verified live account catalog)
        end
    end

    %% -----------------------------------------------------------
    %% 6. JSON PARSING, REASONING EFFORT MAPPING & RESPONSE
    %% -----------------------------------------------------------
    rect rgb(30, 35, 55)
        Note over AS,FE: 6. JSON Parsing, Effort Options & Response
        AS->>AS: Locate first '{' and JSON.parse(stdout)
        loop For each model in codexData.models
            AS->>AS: Filter: cm.visibility !== 'hide'
            AS->>AS: Sort by priority (asc)
            AS->>AS: Map cm.supported_reasoning_levels -> effortOptions (low/medium/high/max)
            AS->>AS: Map icon visuals -> /model-icons/openai.svg
            AS->>AS: Register model slug in codexModelIds Set
        end
        AS->>AS: Merge with Antigravity models: [...agyModels, ...codexModels]
        AS->>AS: Cache in sandboxModelsCache (TTL: 5s if linked but 0 models, else 300s)
        AS-->>GW: Return combined DynamicModelOption[]
        GW-->>FE: HTTP 200 { success: true, data: models }
        FE->>FE: Update lastModels in memory (TTL 30s)
        FE-->>User: Populate model dropdown (e.g. gpt-6-luna, gpt-5.6-terra, gemini-3.8-flash)
    end
