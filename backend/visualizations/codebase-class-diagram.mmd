  %% =========================================================================
  %% EXPLICIT RELATIONSHIPS & BRIDGES ACROSS FULL CODEBASE
  %% =========================================================================

  %% Frontend Component Hierarchy
  AppComponent *-- HeaderComponent : contains
  AppComponent *-- SidebarComponent : contains
  AppComponent *-- PromptBarComponent : contains
  AppComponent *-- CloudInspectorComponent : contains
  AppComponent *-- AuthModalComponent : contains
  AppComponent *-- DeleteSandboxModalComponent : contains
  HeaderComponent *-- ModelSelectorDropdownComponent : contains
  HeaderComponent *-- UserMenuComponent : contains
  PromptBarComponent *-- SlashCommandPaletteComponent : toggles
  AppComponent *-- MarkdownContentComponent : renders
  MarkdownContentComponent *-- CodeArtifactComponent : embeds

  %% Frontend Components -> Client Services
  AppComponent --> ModelsServiceClient : fetches dynamic models
  AppComponent --> CliAuthServiceClient : synchronizes CLI auth state
  AppComponent --> SessionSyncServiceClient : persists sessions via backend Fastify API
  AppComponent --> ApiUtil_Frontend : streams SSE agent runs
  AppComponent ..> JotaiStateAtoms : reactive binding
  PromptBarComponent ..> SlashCommandUtil : resolves / commands
  ModelSelectorDropdownComponent ..> QuotaUtil_Frontend : delegates isQuotaGroupExhausted
  AuthModalComponent --> FirebaseAuthServiceClient : executes Google OAuth
  AuthModalComponent --> CliAuthServiceClient : opens CLI device auth popups
  SidebarComponent ..> TokenMetricsUtil : formats token usage badges

  %% Client -> Server Bridge
  ApiUtil_Frontend ..> FastifyServer : HTTP Requests and SSE Streaming
  SessionSyncServiceClient ..> SessionController : REST /api/v1/sessions
  CliAuthServiceClient ..> CliAuthController : REST /api/v1/auth/cli
  ModelsServiceClient ..> AgentController : REST /api/v1/agent/models

  %% Server Gateway -> Controllers & Routes
  FastifyServer --> AgentRoutes : registers
  FastifyServer --> SandboxRoutes : registers
  FastifyServer --> AuthRoutes : registers
  FastifyServer --> QuotaRoutes : registers
  FastifyServer --> SessionRoutes : registers
  FastifyServer --> RateLimitRoutes : registers
  FastifyServer ..> EnvConfig : loads configuration

  AgentRoutes --> AgentController : dispatches
  SandboxRoutes --> SandboxController : dispatches
  AuthRoutes --> AuthController : dispatches
  AuthRoutes --> CliAuthController : dispatches
  QuotaRoutes --> AntigravityQuotaService : queries live agy quota
  QuotaRoutes --> CodexQuotaService : queries live codex quota
  SessionRoutes --> SessionController : dispatches

  %% Controllers -> Services
  AgentController --> AgentService : invokes
  AgentController --> RateLimitService : checks IP rate limits
  SandboxController --> SandboxService : invokes
  AuthController --> AuthService : invokes
  CliAuthController --> CliAuthService : invokes
  SessionController --> SessionService : invokes

  %% Core Agent Execution Pipeline
  AgentService --> SandboxService : dispatches prompt execution into microVMs
  AgentService --> ContextCompactorUtil : compacts past conversation history
  AgentService --> AntigravityQuotaService : records turn metrics
  AgentService --> CodexQuotaService : records turn metrics
  AgentService --> FirestoreBackendService : reads/persists turns

  %% Sandbox Module Internal Composition
  SandboxService o-- E2BSandboxProvider : active cloud microVM provider
  E2BSandboxProvider --> FirestoreBackendService : syncs VM state
  E2BSandboxProvider ..> IdUtil : generates sandbox IDs
  E2BSandboxProvider ..> LoggerUtil : streams diagnostics

  %% Quota & Auth Services Interactions
  AntigravityQuotaService --> SandboxService : queries live agy CLI
  CodexQuotaService --> SandboxService : queries live codex CLI
  AntigravityQuotaService --> FirestoreBackendService : saves quota telemetry
  CodexQuotaService --> FirestoreBackendService : saves quota telemetry
  CliAuthService --> FirestoreBackendService : saves tokens securely
  CliAuthService --> SandboxService : hot-swaps CLI credentials into microVMs
  AuthService --> TokenUtil_Backend : issues 7-day signed JWT
  AuthService --> FirestoreBackendService : syncs user profile
  SessionService --> FirestoreBackendService : persists sessions and chat turns

  %% Utilities
  AgentController ..> ResponseUtil : formats JSON response
  SandboxController ..> ResponseUtil : formats JSON response
  AuthController ..> ResponseUtil : formats JSON response
  AgentService ..> AppError : throws structured operational errors
  SandboxService ..> AppError : throws structured operational errors
