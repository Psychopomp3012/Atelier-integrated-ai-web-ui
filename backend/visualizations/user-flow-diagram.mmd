flowchart TD
    subgraph Client["🖥️ User & Client Browser (React 19)"]
        A([fa:fa-globe Open Atelier Web App]) --> B["fa:fa-sliders Hydrate Unified Store: atelier_prefs_usr_..."]
        B --> C{fa:fa-key Valid 7-Day JWT?}
        C -->|No / Expired| D[fa:fa-google Google OAuth Login]
        D --> EModal["fa:fa-times Close AuthModal & Activate 3D Cube (z-100)"]
        EModal --> E["fa:fa-id-card Exchange Google Token for 7-Day JWT"]
        E --> Cube["🧊 3D Rotating Cube (Single-Flight Hydration Barrier, z-100)"]
        C -->|Yes / Active| Cube

        subgraph Hydration["🌊 Single-Flight Cloud Hydration Pipeline"]
            Cube --> Hydrate1["1. Linked CLI Detection: GET /api/v1/auth/cli/status"]
            Cube --> Hydrate2["2. Sandboxes Created: GET /api/v1/sandboxes"]
            Cube --> Hydrate3["3. Sidebar Chats (Pure Metadata: id, title, count): GET /api/v1/sessions"]

            Hydrate1 & Hydrate2 & Hydrate3 --> TargetRes["🎯 Target Session via preferencesService"]
            TargetRes --> Hydrate4["4. Active Messages: GET /api/v1/sessions/:id"]
            TargetRes --> Hydrate5["5. Quota & Models: GET /api/v1/quota & models"]

            Hydrate4 & Hydrate5 --> ModelReconcile{"🔗 Any Linked CLI?"}
            ModelReconcile -->|Yes| SetBestLinked["Auto-select Best Linked Model & Save Prefs"]
            ModelReconcile -->|None| SetNoneModel["Set 'none' (No Model Selected)"]

            SetBestLinked & SetNoneModel --> MinWindow["⏱️ Min Presentation Threshold: 750ms Window"]
        end

        MinWindow --> F[fa:fa-th-large Dismiss 3D Cube & Mount Workspace]

        F --> MP[fa:fa-layer-group Open Model & Provider Selector]
        MP --> G{fa:fa-link Provider Linked?}
        G -->|No / Locked| H[fa:fa-shield Prompt Subscriptions Auth]
        H --> I[fa:fa-user-check Authorize Provider OAuth]
        I --> J[fa:fa-save Save Credential to Firestore]
        J --> MP

        G -->|Yes / Unlocked| SBState{fa:fa-server Sandbox Attached?}
        
        SBState -->|No VM Running| VMReq[fa:fa-rocket Prompt: Sandbox VM Required]
        VMReq -->|Click 'Start Sandbox VM'| KN[fa:fa-plus-circle Request MicroVM Allocation]

        SBState -->|VM Active but Detached| VMAttach[fa:fa-link-slash Prompt: Attach Sandbox VM]
        VMAttach -->|Select Existing VM| KA[fa:fa-link Attach Workspace to Session]

        SBState -->|VM Attached| QueryVM[fa:fa-microchip Live MicroVM Query in Progress]

        K{fa:fa-cubes Sandbox Manager} -->|Manage / Delete| KD[fa:fa-trash-alt Custom Red Delete Modal]
        KD -->|Confirm| KDR[fa:fa-minus-circle Release Quota Slot in Firestore]

        MD[fa:fa-list-check Dynamic Models & Effort List] --> S[fa:fa-sliders Choose Model & Effort Level]
        S --> T[fa:fa-paper-plane Dispatch User Prompt]
        Z[fa:fa-stream Stream SSE Tokens & Steps] --> AB([fa:fa-desktop Cloud Inspector Explorer])

        F --> SignOutAction[fa:fa-sign-out-alt User Signs Out]
        SignOutAction --> LogoutReq["fa:fa-sign-out-alt POST /api/v1/auth/logout"]
        LogoutReq --> Cleanup["fa:fa-broom performUserCleanup: Invalidate Tokens, Caches & State"]
        Cleanup --> D
    end

    subgraph Cloud["☁️ Backend Orchestrator & E2B MicroVM"]
        KDR --> K

        KA --> ForcedSync
        KN --> L{fa:fa-server Sandbox Active?}
        L -->|No / New| M[fa:fa-cloud Launch Firecracker VM]
        M --> N[fa:fa-microchip Allocate 1GB Swap]
        N --> O[fa:fa-lock Set agent-runner DAC Boundary]
        O --> P["fa:fa-download Pre-Install CLIs: agy/codex/claude"]
        P --> Q[fa:fa-key Pre-Seed Linked Credentials]
        L -->|Yes / Reconnect| R[fa:fa-play Resume / Reactivate MicroVM]
        R --> RHash["fa:fa-arrows-rotate Invalidate Sandbox Credential Hash"]
        LogoutReq -.-> InvalidateUserHash["fa:fa-ban Invalidate User Credential Hash"]
        
        Q --> ForcedSync
        RHash --> ForcedSync
        QueryVM --> ForcedSync["fa:fa-key Forced JIT Credential Sync: Write auth.json & Set CODEX_HOME"]
        ForcedSync --> RunCliLive[fa:fa-terminal Execute Live CLI Discovery inside VM]
        RunCliLive --> CLIModels["fa:fa-search Live CLI Discovery: agy models / codex debug models"]
        RunCliLive --> CLIQuota["fa:fa-tachometer-alt Live Telemetry Quota: 5h/Weekly & Rolling Limits"]
        CLIModels --> ZeroHardcode[fa:fa-shield-alt Zero-Hardcode & Zero-Firestore Volatile Rule]
        CLIQuota --> ZeroHardcode
        ZeroHardcode --> MD

        T --> TH[fa:fa-database Fetch History from Firestore]
        TH --> TC["fa:fa-compress-arrows-alt Context Compactor: One-Shot Prompt Stitching"]
        TC --> U{fa:fa-sync Linked Post-Boot?}
        U -->|Yes / Hot-Swap| V[fa:fa-bolt Dynamic Live Credential Injection]
        U -->|No / Pre-Warmed| W[fa:fa-check-circle Pre-Flight Credential Verification]
        V --> X[fa:fa-terminal Execute One-Shot CLI inside MicroVM]
        W --> X
        X --> Y{fa:fa-question-circle CLI Exit Code == 0?}
        Y -->|Yes| FS[fa:fa-save Save Response Turn to Firestore]
        FS --> Z
        Y -->|No / Auth Err| AA[fa:fa-exclamation-triangle Prompt Auth Relink or Diagnostic]
        AA --> Z
    end
